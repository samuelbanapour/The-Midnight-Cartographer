<!--
  AndroidManifest additions for Vungle ads + Amazon IAP.
  Merge these into android/app/src/main/AndroidManifest.xml.
-->

<!-- 1. Permissions: place these as direct children of <manifest>, before <application>. -->
<uses-permission android:name="android.permission.INTERNET" />
<uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

<!--
  2. Amazon IAP ResponseReceiver: place this INSIDE the <application> element.
     Required so PurchasingService can deliver purchase/response broadcasts.
-->
<receiver
    android:name="com.amazon.device.iap.ResponseReceiver"
    android:exported="true"
    android:permission="com.amazon.inapp.purchasing.Permission.NOTIFY">
    <intent-filter>
        <action android:name="com.amazon.inapp.purchasing.NOTIFY" />
    </intent-filter>
</receiver>

<!--
  NOTE: Vungle needs no manifest activity/receiver entries — its AAR merges
  everything it needs automatically. No Amazon AdActivity anymore (that SDK
  is retired).
-->
